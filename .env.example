# Optional defaults when setup page does not send merchantApiKey/env/region.
# Prefer configuring credentials via the setup page in the browser.

MERCHANT_API_KEY=
IDENTITY_API_URL=https://api-gateway.sandbox.ngenius-payments.com/identity/auth/access-token
TRANSACTIONS_SERVICE_URL=https://api-gateway.sandbox.ngenius-payments.com/transactions/

# Cloud hosts (Render, Railway, etc.) inject PORT. Local default is 3001.
PORT=3001
HOST=0.0.0.0

# Set to production on hosted deployments
NODE_ENV=development
